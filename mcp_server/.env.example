# Shared HS256 secret between app and mcp-server — both files must match
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_SIGNING_SECRET=change-me-generate-with-python-secrets

# Local dev only — docker-compose overrides this to http://app:8000 via environment:
BACKEND_URL=http://localhost:8000

PORT=8010

# OAuth 2.1 — set to your public MCP server URL to enable OAuth for Claude.ai / ChatGPT.
# Leave empty (or omit) to use direct API-key Bearer auth only (Claude Code).
#
# IMPORTANT: set this here in mcp_server/.env, not in the root docker-compose .env.
# docker-compose.yml reads OAUTH_TOKEN_STORAGE from its environment: section, but
# OAUTH_BASE_URL must come from this file so it is not accidentally overridden.
#
OAUTH_BASE_URL=https://mcp.yourdomain.com
# OAUTH_TOKEN_STORAGE=~/.pi-planning/oauth_tokens.json  # local dev default (Docker uses /data/)
# OAUTH_TOKEN_TTL=3600

# Logging level for mcp_server's own loggers (DEBUG, INFO, WARNING, ERROR).
# WARNING: do not use DEBUG in production — token values may appear in logs.
# LOG_LEVEL=INFO

# Logging level for FastMCP/uvicorn framework loggers (controls "INFO: Started server..." noise).
# Should match LOG_LEVEL. Defaults to INFO if unset (FastMCP default).
# FASTMCP_LOG_LEVEL=warning
