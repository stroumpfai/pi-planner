SONAR_TOKEN=your-sonarqube-token

# Both services refuse to start while a secret below still contains "change-me"
# or is shorter than 32 characters.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-python-secrets

# Shared HS256 secret between app and mcp-server — both files must match
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_SIGNING_SECRET=change-me-generate-with-python-secrets

# Container user (match the owner of ./data on the host; default 10001)
# APP_UID=1000
# APP_GID=1000
